---
import { getEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  representativeStructuredData,
} from "../../shared/seoOutput";
import { canonicalUrl, type SeoRoute } from "../../shared/seoRouteManifest";

const entry = await getEntry("representativePages", "home");
if (!entry) throw new Error("Missing representative content entry: home");
const page = entry.data;
const seoPage: SeoRoute = {
  route: "/",
  canonical: canonicalUrl("/"),
  lang: page.lang,
  locale: "en_US",
  title: page.title,
  description: page.description,
  company: "Tengcle",
  ogType: "website",
};
const principleSection = page.sections[1];
---

<SiteLayout
  page={seoPage}
  structured={representativeStructuredData(seoPage, "home")}
>
  <main id="main-content">
    <section class="global-hero" aria-labelledby="global-heading">
      <div class="global-hero__inner">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 id="global-heading">{page.heading}</h1>
        <p class="master-tagline">{page.masterTagline}</p>
        <p class="supporting-line" lang="ja">{page.supportingLine}</p>
        <p class="lead">{page.intro}</p>
        <nav class="hero-links" aria-label="Featured pages">
          <a href="#purpose">Our purpose</a>
          <a href="/companies/japan/">Company</a>
          <a href="/activities/property-management/">Activity</a>
        </nav>
      </div>
    </section>

    <section class="home-section purpose-section" id="purpose" lang="ja">
      <p class="eyebrow">Purpose</p>
      <h2>{page.purpose}</h2>
      <p>{page.purposeExplanation}</p>
      <ol class="action-model" aria-label="価値を育てる行動の循環">
        {page.actionModel.map(stage => <li>{stage}</li>)}
      </ol>
    </section>

    <section class="home-section" id="approach">
      <p class="eyebrow">Our approach</p>
      <h2>{page.sections[0].heading}</h2>
      <p>{page.sections[0].body}</p>
      <div class="principle-grid">
        <article class="principle-card">
          <h3>{principleSection.heading}</h3>
          <p>{principleSection.body}</p>
        </article>
        <article class="principle-card">
          <h3>Different perspectives, one purpose</h3>
          <p>
            “One” does not ask everyone to think alike or reduce reality to a
            single answer. It means keeping context and different viewpoints
            present while turning understanding into clear, responsible action.
          </p>
        </article>
      </div>
    </section>

    <section class="home-section" id="companies">
      <p class="eyebrow">Related companies</p>
      <h2>Three legal entities, stated without hierarchy.</h2>
      <div class="company-grid">
        <article class="company-card">
          <p class="company-card__legal">株式会社Tengcle</p>
          <h3>Japan</h3>
          <p>Incorporated in Tokyo on 25 October 2021.</p>
          <a href="/companies/japan/">View verified company information</a>
        </article>
        <article class="company-card">
          <p class="company-card__legal">Tengcle Limited</p>
          <h3>Hong Kong</h3>
          <p>Incorporated in Hong Kong on 29 April 2025.</p>
          <a href="/hk/en/">Visit the Hong Kong regional site</a>
        </article>
        <article class="company-card">
          <p class="company-card__legal">Tengcle Development LLC</p>
          <h3>United States</h3>
          <p>Formed in New Jersey on 5 January 2026.</p>
          <a href="/us/en/">Visit the United States regional site</a>
        </article>
      </div>
    </section>

    <section class="home-section" id="activities">
      <p class="eyebrow">Representative activity</p>
      <h2>Current work is separated from preparation and future direction.</h2>
      <p>
        Activity pages identify the responsible entity, place, public status,
        and update date. Claims are kept deliberately narrower than the work
        until their evidence is ready for publication.
      </p>
      <nav class="related-links" aria-label="Activity pages">
        <a href="/activities/property-management/">Property management</a>
      </nav>
    </section>
  </main>
</SiteLayout>
