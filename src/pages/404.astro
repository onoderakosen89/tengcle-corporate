---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta
      name="description"
      content="The requested Tengcle page does not exist."
    />
    <title>Page Not Found | Tengcle</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <main id="main-content" class="legacy-static__main">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The requested page does not exist or has moved.</p>
      <nav aria-label="Recovery links">
        <a href="/">Return to Tengcle</a>
        <a href="/companies/japan/">View company information</a>
      </nav>
    </main>
  </body>
</html>
