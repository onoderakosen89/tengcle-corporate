---
import { getEntry } from "astro:content";
import DetailPage from "../../../components/DetailPage.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import {
  representativeStructuredData,
} from "../../../../shared/seoOutput";
import { representativeRouteManifest } from "../../../../shared/site2RouteManifest";

const entry = await getEntry("representativePages", "company-japan");
if (!entry) throw new Error("Missing representative content entry: company-japan");
const page = entry.data;
const seoPage = representativeRouteManifest.find(
  route => route.route === "/companies/japan"
)!;
---

<SiteLayout
  page={seoPage}
  structured={representativeStructuredData(seoPage, "company")}
  legalName={page.legalName}
>
  <DetailPage page={page} />
</SiteLayout>
