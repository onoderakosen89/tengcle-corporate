---
import { getEntry } from "astro:content";
import DetailPage from "../../../components/DetailPage.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import {
  representativeStructuredData,
} from "../../../../shared/seoOutput";
import { representativeRouteManifest } from "../../../../shared/site2RouteManifest";
import { representativePublicationSchema } from "../../../../shared/representativePageSchema";

const entry = await getEntry(
  "representativePages",
  "activity-property-management"
);
if (!entry) {
  throw new Error(
    "Missing representative content entry: activity-property-management"
  );
}
const page = representativePublicationSchema.parse(entry.data);
const seoPage = representativeRouteManifest.find(
  route => route.route === "/activities/property-management"
)!;
---

<SiteLayout
  page={seoPage}
  structured={representativeStructuredData(seoPage, "activity")}
  legalName="株式会社Tengcle"
>
  <DetailPage page={page} />
</SiteLayout>
